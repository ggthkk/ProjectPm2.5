# Use existing secrets. Do not commit .env.
API_KEY=
DISCORD_WEBHOOK_URL=
# Existing MAP supports multiple locations separated by semicolons.
MAP=
# Optional: separate channels. Blank values use DISCORD_WEBHOOK_URL.
DISCORD_GAMES_WEBHOOK_URL=
DISCORD_NEWS_WEBHOOK_URL=
DISCORD_ALERTS_WEBHOOK_URL=
DISCORD_WEATHER_WEBHOOK_URL=
TZ=Asia/Bangkok
DIGEST_TIME=09:00
POLL_INTERVAL=30m
QUIET_START=23
QUIET_END=8
MAX_ALERTS_PER_DAY=3
# Water stations within this radius of MAP. Provinces are fallback only when MAP is absent.
WATER_RADIUS_KM=10
# 10=Bangkok, 12=Nonthaburi, 13=Pathum Thani.
WATER_PROVINCES=10,12,13
ALERT_AREAS=กรุงเทพ,นนทบุรี,ปทุมธานี,Bangkok,Nonthaburi,Pathum Thani
GAME_PLATFORMS=Steam,Epic Games Store,GOG
ENABLE_AIR=true
ENABLE_VALORANT=true
ENABLE_GAMES=true
ENABLE_NEWS=true
ENABLE_WATER=true
ENABLE_DISASTERS=true
ENABLE_RIOT_STATUS=true
